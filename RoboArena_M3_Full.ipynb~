    "# Payoff matrix: PAYOFF[(action_i, action_j)] = (payoff_i, payoff_j)\n",
    "PAYOFF = {(\"C\", \"C\"): (10, 10), (\"C\", \"D\"): (5, 0), (\"D\", \"C\"): (0, 5), (\"D\", \"D\"): (0, 0)}\n",
